{
  "name": "thea",
  "version": "3.53.0",
  "description": "Thea's read-only route as MCP tools, the failure-ledger skill, the land, sync and rekick lane skills you invoke by name, and two advisory hooks: a shell string Thea refuses is put to you (ask, never deny), an edited file's gates come back as context, and each hook call is the session's heartbeat, its end recorded when the session closes.",
  "author": {"name": "HLIntel LLC"},
  "homepage": "https://github.com/HLIntel/thea-software",
  "license": "MIT",
  "mcpServers": {
    "thea": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/thea_mcp.py"],
      "env": {"THEA_ROOT": "${CLAUDE_PLUGIN_ROOT}"}
    }
  },
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/atlas.py\" shell --hook"}]}
    ],
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit", "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/atlas.py\" port --hook"}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/atlas.py\" agents --hook claude-code --end"}]}
    ]
  }
}
