{
  "name": "Code-Development atlas",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "pip install --quiet -r scripts/requirements.txt && python scripts/atlas.py check",
  "postAttachCommand": "python scripts/atlas.py index",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "redhat.vscode-yaml", "github.vscode-github-actions"],
      "settings": {
        "yaml.schemas": { "./languages/PACK-TOOLS-SPEC.md": "languages/*/tools.yaml" },
        "files.trimTrailingWhitespace": true
      }
    }
  },
  "remoteUser": "vscode"
}
