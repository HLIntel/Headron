{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/HLIntel/Headron/tools/codexbrief.schema.json",
  "title":"Headron compact Codex context",
  "type":"object",
  "required":["schema","id","version","path","route","scope","change","runtime","gates","labels","traps","next","uncertainty"],
  "additionalProperties":false,
  "properties":{
    "schema":{"const":1},
    "id":{"const":"headron.brief"},
    "version":{"type":"string"},
    "path":{"type":"string"},
    "route":{"type":"string"},
    "scope":{"oneOf":[{"type":"string"},{"type":"null"}]},
    "task":{"type":"string"},
    "change":{"type":"string"},
    "runtime":{"type":"object","required":["id","runtime","loads","adapter","headron_via"],"additionalProperties":false,"properties":{"id":{"type":"string"},"runtime":{"type":"string"},"loads":{"type":"string"},"adapter":{"type":"string"},"headron_via":{"type":"array","items":{"type":"string"}}}},
    "gates":{"type":"array","minItems":1,"items":{"type":"string"}},
    "labels":{"type":"array","items":{"type":"string"}},
    "traps":{"type":"array","items":{"type":"object","required":["id","looks_like"],"additionalProperties":false,"properties":{"id":{"type":"string"},"looks_like":{"type":"string"}}}},
    "next":{"type":"string"},
    "uncertainty":{"type":"string"}
  }
}
