{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HLIntel/thea-software/blob/main/tools/atlas-output.schema.json",
  "title": "Atlas machine output",
  "description": "THE EXTERNAL API. A consuming repository depends on these records \u2014 on route ids, gate ids, task ids and manifest paths \u2014 and never on a rendered document, because prose is re-worded without notice and a schema is not. Every record carries `schema`, so a consumer pinned to a format is told when it changes rather than left to discover a field missing.",
  "oneOf": [
    {
      "$ref": "#/$defs/route"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/process"
    },
    {
      "$ref": "#/$defs/gate"
    },
    {
      "$ref": "#/$defs/decide"
    },
    {
      "$ref": "#/$defs/check"
    },
    {
      "$ref": "#/$defs/verify"
    },
    {
      "$ref": "#/$defs/doctor"
    },
    {
      "$ref": "#/$defs/intake"
    },
    {
      "$ref": "#/$defs/shell"
    },
    {
      "$ref": "#/$defs/delegate"
    },
    {
      "$ref": "#/$defs/handoff"
    },
    {
      "$ref": "#/$defs/cadence"
    },
    {
      "$ref": "#/$defs/role"
    },
    {
      "$ref": "#/$defs/resume"
    },
    {
      "$ref": "#/$defs/steps"
    },
    {
      "$ref": "#/$defs/failures"
    },
    {
      "$ref": "#/$defs/successes"
    },
    {
      "$ref": "#/$defs/brainstorm"
    },
    {
      "$ref": "#/$defs/port"
    }
  ],
  "$defs": {
    "nullable_string": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route": {
      "type": "object",
      "required": [
        "schema",
        "command",
        "path",
        "route",
        "resolved_by",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "command": {
          "const": "route"
        },
        "path": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/nullable_string"
        },
        "resolved_by": {
          "type": "string",
          "description": "WHICH precedence rule resolved this, so an explicit match and a lucky guess do not look alike."
        },
        "evidence": {
          "type": "string"
        },
        "precedence": {
          "type": "array",
          "minItems": 1,
          "description": "Every declared precedence rule, and whether THIS router resolved it. A consumer reading only `resolved_by` cannot tell that a rule above it was never consulted.",
          "items": {
            "type": "object",
            "required": [
              "rule",
              "resolved_here"
            ],
            "additionalProperties": false,
            "properties": {
              "rule": {
                "type": "string"
              },
              "resolved_here": {
                "type": "boolean"
              }
            }
          }
        },
        "guide": {
          "type": "string"
        },
        "operating_card": {
          "type": "string"
        },
        "tool_manifest": {
          "type": "string"
        },
        "manifest_present": {
          "type": "boolean"
        },
        "authority": {
          "type": "object"
        },
        "authority_by_class": {
          "type": "object",
          "description": "Roles grouped by the CLAIM they support. A green compiler is type authority, never behaviour authority."
        },
        "authority_gaps": {
          "type": "object",
          "description": "Classes no tool in this pack answers, each naming what does."
        },
        "default_tools": {
          "$ref": "#/$defs/string_list"
        },
        "label": {
          "type": "string"
        },
        "branch_lane": {
          "type": "string"
        },
        "worktree": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "mcp": {
          "type": "string"
        },
        "operations": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        },
        "scope": {
          "oneOf": [
            {
              "$ref": "#/$defs/directory_scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "lessons": {
          "$ref": "#/$defs/lesson_list"
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "schema",
        "command",
        "path",
        "route",
        "task",
        "tools",
        "change_class",
        "required_gates"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "command": {
          "const": "plan"
        },
        "path": {
          "type": "string"
        },
        "route": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "tools": {
          "$ref": "#/$defs/string_list"
        },
        "change_class": {
          "$ref": "#/$defs/nullable_string"
        },
        "risk_modifiers": {
          "$ref": "#/$defs/string_list"
        },
        "required_gates": {
          "oneOf": [
            {
              "$ref": "#/$defs/string_list"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk_modifier_catalog": {
          "type": "object"
        },
        "change_classes": {
          "$ref": "#/$defs/string_list"
        },
        "verification_tiers": {
          "$ref": "#/$defs/string_list"
        },
        "guide": {
          "type": "string"
        },
        "operating_card": {
          "type": "string"
        },
        "tool_manifest": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        },
        "branch_policy": {
          "type": "string"
        }
      }
    },
    "process": {
      "type": "object",
      "required": [
        "schema",
        "command",
        "atlas_version",
        "process",
        "task_profile",
        "change_class",
        "required_gates",
        "sequence",
        "artifacts",
        "stop_when",
        "escalate_when"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "command": {
          "const": "process"
        },
        "atlas_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "process": {
          "type": "string"
        },
        "task_profile": {
          "type": "string"
        },
        "tools": {
          "$ref": "#/$defs/string_list"
        },
        "change_class": {
          "type": "string"
        },
        "required_gates": {
          "$ref": "#/$defs/string_list"
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "step",
              "means"
            ],
            "additionalProperties": false,
            "properties": {
              "step": {
                "type": "string"
              },
              "means": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "artifacts": {
          "$ref": "#/$defs/string_list"
        },
        "stop_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "A process that never says when to stop expands until something else notices."
        },
        "escalate_when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "task_contract_schema": {
          "type": "string"
        }
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "schema",
        "command",
        "atlas_version",
        "path",
        "route",
        "gate",
        "state",
        "argv",
        "why"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "command": {
          "const": "gate"
        },
        "atlas_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/nullable_string"
        },
        "gate": {
          "type": "string"
        },
        "state": {
          "enum": [
            "runnable",
            "absent",
            "undeclared"
          ]
        },
        "argv": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/string_list"
            }
          ]
        },
        "why": {
          "type": "string"
        }
      }
    },
    "decide": {
      "type": "object",
      "required": [
        "schema",
        "command",
        "atlas_version",
        "id",
        "decides",
        "options",
        "axes",
        "choose_when",
        "failure_mode",
        "verified_by",
        "source"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "command": {
          "const": "decide"
        },
        "atlas_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "id": {
          "type": "string"
        },
        "decides": {
          "type": "string"
        },
        "options": {
          "$ref": "#/$defs/string_list"
        },
        "axes": {
          "$ref": "#/$defs/string_list"
        },
        "choose_when": {
          "type": "object"
        },
        "failure_mode": {
          "type": "string"
        },
        "verified_by": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "pattern": "^https://"
        },
        "source_verified": {
          "type": "boolean"
        },
        "uncertain": {
          "type": "string"
        },
        "proven_by": {
          "type": "string"
        },
        "evidence": {
          "type": "object",
          "description": "3.21.0: the data (with its source), the trend, and who pays for the wrong choice",
          "properties": {
            "data": {
              "type": "string"
            },
            "trend": {
              "type": "string"
            },
            "human": {
              "type": "string"
            }
          },
          "required": [
            "data",
            "trend",
            "human"
          ],
          "additionalProperties": false
        },
        "lessons": {
          "$ref": "#/$defs/lesson_list"
        }
      },
      "additionalProperties": false
    },
    "directory_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "is",
        "proves",
        "never",
        "traps",
        "reference",
        "label"
      ],
      "description": "The PLACE a path works in \u2014 the third routing axis. `route` answers what language a file is and the change class answers what proof it needs; this answers what the directory itself declares, which is what `allowed_paths` in every task contract has always been written in terms of. Null when no directory_scopes entry contains the path.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "is": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "proves": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "never": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "traps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Keys of atlas.yaml/agent_failure_modes met IN THIS PLACE. The ledger is global and the traps are local: an agent editing one directory had to read all of them or none."
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lesson_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure",
          "tell",
          "do"
        ],
        "properties": {
          "failure": {
            "type": "string",
            "minLength": 1
          },
          "tell": {
            "type": "string"
          },
          "do": {
            "$ref": "#/$defs/nullable_string"
          }
        }
      },
      "description": "The ledger at the point of design (3.44.0): shapes this target's own guards enforce, or that share two words with it, each with its tell and the move that replaces it."
    },
    "nullable_integer": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "port": {
      "type": "object",
      "description": "`thea port <file|dir|.>`: the socket an agent plugs into \u2014 route, tier, gates, lessons and next steps for one target. Its record id is a string, not the integer every `command` record carries.",
      "required": [
        "schema",
        "atlas_version",
        "target",
        "lens",
        "frame",
        "tier",
        "line"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "thea-port/1"
        },
        "atlas_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "target": {
          "type": "string",
          "description": "The target relative to the caller's worktree; `.` for the whole tree."
        },
        "lens": {
          "enum": [
            "narrow",
            "code",
            "codebase"
          ],
          "description": "narrow is one file, code a directory, codebase the tree. The lens decides which body fields follow."
        },
        "frame": {
          "enum": [
            "codebase",
            "chat",
            "tree",
            "model",
            "agent"
          ],
          "description": "chat drops `gates` and `next`; model adds `model`; agent adds `plug`."
        },
        "tier": {
          "$ref": "#/$defs/nullable_string",
          "description": "The stack tier of a narrow target; null for a directory or the tree, which carry `tiers` instead."
        },
        "route": {
          "$ref": "#/$defs/nullable_string"
        },
        "place": {
          "$ref": "#/$defs/nullable_string"
        },
        "labels": {
          "$ref": "#/$defs/string_list"
        },
        "gates": {
          "type": "array",
          "description": "narrow only: each required gate of a source change and the one command that runs it, or null when none is declared.",
          "items": {
            "type": "object",
            "required": [
              "gate",
              "run"
            ],
            "additionalProperties": false,
            "properties": {
              "gate": {
                "type": "string"
              },
              "run": {
                "$ref": "#/$defs/nullable_string"
              },
              "installed": {
                "type": "boolean",
                "description": "whether the command's program resolves on this machine; false means a run is NOT RUN here, never a pass"
              }
            }
          }
        },
        "lessons": {
          "$ref": "#/$defs/lesson_list"
        },
        "routes": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "code and codebase: tracked files per route, most common first."
        },
        "tiers": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          },
          "description": "code and codebase: tracked files per stack tier."
        },
        "read": {
          "$ref": "#/$defs/string_list"
        },
        "is": {
          "$ref": "#/$defs/nullable_string"
        },
        "proves": {
          "$ref": "#/$defs/string_list"
        },
        "traps": {
          "$ref": "#/$defs/string_list"
        },
        "files": {
          "type": "integer"
        },
        "entries": {
          "$ref": "#/$defs/string_list"
        },
        "next": {
          "$ref": "#/$defs/string_list",
          "description": "The `thea` commands this lens offers next, in order."
        },
        "model": {
          "type": "object",
          "required": [
            "routes",
            "mcp_server_tokens"
          ],
          "additionalProperties": false,
          "properties": {
            "routes": {
              "type": "object"
            },
            "mcp_server_tokens": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "plug": {
          "type": "object",
          "required": [
            "runtime",
            "loads",
            "adapter",
            "hooks",
            "runtimes"
          ],
          "additionalProperties": false,
          "properties": {
            "runtime": {
              "$ref": "#/$defs/nullable_string"
            },
            "loads": {
              "$ref": "#/$defs/nullable_string"
            },
            "adapter": {
              "$ref": "#/$defs/nullable_string"
            },
            "hooks": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "runtimes": {
              "$ref": "#/$defs/string_list"
            }
          }
        },
        "line": {
          "type": "string",
          "description": "The record as one fixed-glyph line, the form a hook prints."
        }
      }
    },
    "brainstorm": {
      "type": "object",
      "description": "`thea brainstorm <record> --json`: a brainstorm record checked against its rules.",
      "required": [
        "schema",
        "record",
        "chosen",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "thea-brainstorm/1"
        },
        "record": {
          "type": "string"
        },
        "chosen": {
          "$ref": "#/$defs/nullable_string"
        },
        "findings": {
          "$ref": "#/$defs/string_list",
          "description": "Every rule the record breaks; empty only when it may converge."
        }
      }
    },
    "check": {
      "type": "object",
      "description": "`thea check --json`: the contract's verdict; `exit` is the same code the command returns.",
      "required": [
        "schema",
        "command",
        "atlas_version",
        "exit",
        "findings",
        "counts"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "command": {
          "const": "check"
        },
        "atlas_version": {
          "$ref": "#/$defs/nullable_string"
        },
        "exit": {
          "type": "integer"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "severity",
              "blocks",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "severity": {
                "enum": [
                  "error",
                  "warning"
                ]
              },
              "blocks": {
                "$ref": "#/$defs/nullable_string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "counts": {
          "$ref": "#/$defs/nullable_string"
        }
      }
    },
    "verify": {
      "type": "object",
      "description": "`thea verify --json`: one row per gate of the done set, each with its own verdict; `exit` is the command's exit code.",
      "required": [
        "schema",
        "command",
        "atlas_version",
        "rows",
        "tally",
        "exit"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "command": {
          "const": "verify"
        },
        "atlas_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "argv",
              "mutates",
              "machine_dependent",
              "verdict",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "argv": {
                "$ref": "#/$defs/string_list"
              },
              "mutates": {
                "type": "boolean"
              },
              "machine_dependent": {
                "type": "boolean"
              },
              "verdict": {
                "enum": [
                  "PASS",
                  "REUSED",
                  "FAIL",
                  "NOT RUN"
                ]
              },
              "why": {
                "type": "string"
              },
              "exit": {
                "type": "integer"
              },
              "seconds": {
                "type": "number"
              },
              "self_report": {
                "$ref": "#/$defs/string_list"
              },
              "output_bytes": {
                "type": "integer"
              },
              "calls": {
                "type": "integer"
              }
            }
          }
        },
        "tally": {
          "type": "object",
          "required": [
            "PASS",
            "REUSED",
            "FAIL",
            "NOT RUN"
          ],
          "additionalProperties": false,
          "properties": {
            "PASS": {
              "type": "integer"
            },
            "REUSED": {
              "type": "integer"
            },
            "FAIL": {
              "type": "integer"
            },
            "NOT RUN": {
              "type": "integer"
            }
          }
        },
        "exit": {
          "type": "integer"
        }
      }
    },
    "doctor": {
      "type": "object",
      "description": "`thea doctor --json`: whether this machine can run each instrument, and what stops working when one is absent.",
      "required": [
        "schema",
        "command",
        "platform",
        "rows",
        "required_missing",
        "optional_missing"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": 1
        },
        "command": {
          "const": "doctor"
        },
        "platform": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "required",
              "ok",
              "measured",
              "costs_if_absent"
            ],
            "additionalProperties": false,
            "properties": {
              "capability": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              },
              "ok": {
                "type": "boolean"
              },
              "measured": {
                "type": "string"
              },
              "costs_if_absent": {
                "type": "string"
              }
            }
          }
        },
        "required_missing": {
          "type": "integer"
        },
        "optional_missing": {
          "type": "integer"
        }
      }
    },
    "intake": {
      "type": "object",
      "description": "`thea intake <prompt> --json`: a prompt read as role, change class, files, gates and the questions that block action.",
      "required": [
        "schema",
        "command",
        "role",
        "change_class",
