{
  "schema": 1,
  "project": "Thea Software",
  "atlas_version": "3.23.1",
  "read_nothing_first": "resolve a route, then load only what it names",
  "commands": {
    "gate": "python scripts/atlas.py gate <path> <gate> --json",
    "route": "python scripts/atlas.py route <path> --json",
    "plan": "python scripts/atlas.py plan <path> --task <task> --change <class> --json",
    "check": "python scripts/atlas.py check",
    "doctor": "python scripts/atlas.py doctor --json",
    "process": "python scripts/atlas.py process <id> --json",
    "policy": "python scripts/agentpolicy.py <contract>",
    "run": "python scripts/agentrun.py <contract> --json",
    "installed": "atlas --atlas-root <checkout> route <path> --json  (`atlas --where` says which atlas)"
  },
  "intents": "use/install/open/run/pull/report: llms.txt, When asked to",
  "topologies": "CHAT.md, Who hands what to whom",
  "output_schema": "tools/atlas-output.schema.json",
  "identity": {
    "owner": "HeartlandIntel",
    "repository": "thea-software",
    "rename_staged": "HeartlandIntel",
    "rename_applied": null,
    "rule": "display renames; what RESOLVES does not \u2014 identity/published_interfaces"
  },
  "processes": [
    "autonomous_agent",
    "debugging",
    "dependency_change",
    "endpoint",
    "implementation",
    "performance",
    "polyglot",
    "security"
  ],
  "task_contract_schema": "tools/agent-task.schema.json",
  "reference_contract": "tools/agent-task.example.json",
  "controls": [
    "approval",
    "audit",
    "budget",
    "narrow_tools",
    "sandbox"
  ],
  "change_classes": [
    "api_change",
    "concurrency_change",
    "dependency_change",
    "performance_change",
    "quantum_change",
    "retrieval_change",
    "security_sensitive",
    "source_change"
  ],
  "task_profiles": [
    "autonomous_agent",
    "database",
    "debugging",
    "default",
    "endpoint",
    "implementation",
    "mutation",
    "performance",
    "polyglot",
    "quantum",
    "reliability",
    "research",
    "retrieval",
    "security"
  ],
  "forbidden_context": [
    "whole_repo_dump",
    "unrelated_language_packs",
    "duplicate_tool_queries"
  ],
  "failure_modes": "atlas.yaml/agent_failure_modes \u2014 the mistakes committed in this tree, what each looks like from outside, and what refuses it now",
  "not_a_security_boundary": "the runner refuses what it is asked about; an agent that does not ask is bounded by the host, per atlas.yaml/agent_policy/sandbox_requirements",
  "verify_on": "the exit code, never a line of output"
}
