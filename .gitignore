__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.venv/
venv/
*.egg-info/
dist/
node_modules/
.npm/
.pnpm-store/
.next/
coverage/
target/
build/
out/
.cache/
.tmp/
.vscode/*.log
*.swp
*.swo
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Release artifacts are BUILT, never committed: .github/workflows/release.yml produces them,
# attests them and attaches them to the release. A derived artifact in the tree is a second copy
# that ages.
atlas-*.tar.gz
atlas-*.tar.gz.sha256
atlas-*.intoto.jsonl

# ClusterFuzzLite and Go build their own working directories; neither belongs in history.
.clusterfuzzlite/build/
out/fuzz/
*.gcda
*.gcno
crash-*
timeout-*

# An audit stream is written by the runner for one task; it is evidence of a run, not a
# source of the repository, and a committed one is a second copy that ages.
.agent/audit/

# A derived index: rebuilt from the tree by `atlas index build`, never committed.
.agent/index/

# the evidence file's merge lock — a runtime artefact, never content
benchmarks/ab-latest.lock
benchmarks/tasks-latest.lock

# Toolchain caches written beside an example when exrun runs it.
.zig-cache/
zig-out/
# Gleam writes its manifest on every run; a derived artefact never enters the tree.
examples/gleam/manifest.toml

# RUNTIME STORES NEVER ENTER A PUBLIC TREE (3.18.0): a log, a shell history or a trace holds paths,
# hostnames and whatever a command printed — the details the public-repository rule forbids. leaks.py
# asserts each of these stays ignored, so deleting a line here fails the build.
*.log
.*_history
*.trace
.thea/
