{
  "_note": "PINNED, LIKE EVERYTHING ELSE HERE. Two of these servers were `@latest`, which means a different agent environment on two machines on the same day \u2014 the failure this repository spent a release removing from its own workflows. Versions below were read from the registry at the contract version in VERSION; re-read them before trusting them, and pin whatever you copy. An example is not a lockfile, but it is the thing people copy.",
  "inputs": [
    {
      "id": "context7_api_key",
      "type": "promptString",
      "description": "Context7 API key (optional; only the docs profile uses it)",
      "password": true
    }
  ],
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp"
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${input:context7_api_key}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.82"
      ]
    },
    "semgrep": {
      "command": "semgrep",
      "args": [
        "mcp"
      ]
    },
    "dbhub": {
      "command": "npx",
      "args": [
        "@bytebase/dbhub@1.3.1"
      ]
    }
  }
}
