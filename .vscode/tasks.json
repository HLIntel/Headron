{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Atlas: Check",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "check"],
      "problemMatcher": [],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "Atlas: Git Diff Check",
      "type": "process",
      "command": "git",
      "args": ["diff", "--check"],
      "problemMatcher": []
    },
    {
      "label": "Atlas: Git Status",
      "type": "process",
      "command": "git",
      "args": ["status", "--short", "--branch"],
      "problemMatcher": []
    },
    {
      "label": "Atlas: Inspect",
      "dependsOn": ["Atlas: Check", "Atlas: Git Diff Check", "Atlas: Git Status"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Atlas: Gate — test command for the active file",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "gate", "${file}", "unit_tests"],
      "problemMatcher": []
    },
    {
      "label": "Atlas: Land — pull, push, open the PR, arm auto-merge",
      "type": "process",
      "command": "python",
      "args": ["scripts/branchstate.py", "--land"],
      "problemMatcher": []
    },
    {
      "label": "Atlas: Sync — after a merge: pull main, tag the release",
      "type": "process",
      "command": "python",
      "args": ["scripts/branchstate.py", "--sync"],
      "problemMatcher": []
    },
    {
      "label": "Atlas: Route Active File",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "route", "${file}"],
      "problemMatcher": []
    }
  ]
}
