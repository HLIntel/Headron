{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Headron: Check",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "check"],
      "problemMatcher": [],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "Headron: Verify",
      "type": "process",
      "command": "python",
      "args": ["scripts/verify.py"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Port Active File",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "port", "${file}", "--frame", "agent", "--json"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Gate — unit tests for the active file",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "gate", "${file}", "unit_tests"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Gate — lint for the active file",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "gate", "${file}", "lint"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Plan",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "plan", "${file}", "--task", "${input:task}", "--change", "${input:changeClass}", "--json"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Doctor",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "doctor", "--json"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Failures",
      "type": "process",
      "command": "python",
      "args": ["scripts/atlas.py", "failures"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Land — pull, push, open the PR, arm auto-merge",
      "type": "process",
      "command": "python",
      "args": ["scripts/branchstate.py", "--land"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Sync — after a merge: pull main, tag the release",
      "type": "process",
      "command": "python",
      "args": ["scripts/branchstate.py", "--sync"],
      "problemMatcher": []
    },
    {
      "label": "Headron: Inspect (parallel)",
      "dependsOn": ["Headron: Check", "Git: Diff Check", "Git: Status"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Git: Diff Check",
      "type": "process",
      "command": "git",
      "args": ["diff", "--check"],
      "problemMatcher": []
    },
    {
      "label": "Git: Status",
      "type": "process",
      "command": "git",
      "args": ["status", "--short", "--branch"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "task",
      "type": "promptString",
      "description": "Task description for Headron plan"
    },
    {
      "id": "changeClass",
      "type": "pickString",
      "description": "Change class",
      "options": [
        "source_change",
        "api_change",
        "dependency_change",
        "security_sensitive",
        "concurrency_change",
        "performance_change",
        "retrieval_change"
      ],
      "default": "source_change"
    }
  ]
}
