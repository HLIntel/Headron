#!/bin/sh
# NO COMMIT ON A RED RUNG. MEASURED at 2.28.0: a one-liner printed each rung's exit code and then
# committed anyway, because printing a verdict is not gating on it — astshape was red and the commit
# landed. These are the FAST rungs (seconds); the slow planted suites stay in CI, which is required.
# A red rung refuses the commit and names itself. Bypass exists (--no-verify) and is the owner's call.
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
run_python() {
	if command -v uv >/dev/null 2>&1; then
		uv run --frozen --extra crosscheck python "$@"
	else
		python3 "$@"
	fi
}
# enforce check --staged is the rung Headron ships to OTHER repositories, and until 3.32.0 it ran on
# every repository except this one. Running it here found three defects in it, which is what an
# unshipped arm always hides. It is the LAST rung because it is the slowest of the fast ones.
# A red rung prints the last lines of its own output: the finding and the fix it names, so the author
# does not have to re-run the rung to learn why the commit was refused.
for rung in "scripts/atlas.py check" "scripts/astshape.py" "scripts/contextcost.py" "scripts/enforce.py check --staged" "scripts/mdshape.py --staged"; do
	if ! out=$(PYTHONPATH=scripts run_python $rung 2>&1); then
		echo "pre-commit: REFUSED — '$rung' is red. Its last output lines:" >&2
		printf '%s\n' "$out" | tail -n 12 >&2
		fail=1
	fi
done
if command -v ruff >/dev/null 2>&1; then
	if ! out=$(ruff check . 2>&1); then
		echo "pre-commit: REFUSED — 'ruff check .' is red. Its last output lines:" >&2
		printf '%s\n' "$out" | tail -n 12 >&2
		fail=1
	fi
fi
exit $fail
